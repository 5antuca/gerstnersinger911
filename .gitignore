# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# storage local de perfiles (solo next dev)
.dev-perfiles.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example SÍ va al repo: documenta QUÉ variables hacen falta (solo nombres
# y comentarios, nunca valores). Sin esta excepción el `.env*` de arriba también
# lo tapaba y la doc nunca llegaba a un clone.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
