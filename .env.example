# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Para la Fase 4)
MONGODB_URI="mongodb://localhost:27017/gerstnerwerks911"

# Clave del EDITOR (/). El visor de clientes (/ver) es público y no la pide.
# Si queda vacía, el editor NO pide clave (puerta abierta) — se elige así para
# no dejar al dueño afuera por un olvido de configuración.
# En prod se setea en Vercel → Settings → Environment Variables.
# ⚠️ NUNCA poner el valor real acá: este repo es PÚBLICO.
STUDIO_PASSWORD=""

# ── Recuperación de acceso ("¿Olvidaste la clave?") ──
# Mail al que llega el link de acceso temporal. Vive SOLO en el servidor: la
# web nunca lo muestra entero, solo la inicial ("s···").
RECOVERY_EMAIL=""
# API key de Resend (resend.com, plan free). Sin esto el botón avisa que la
# recuperación no está configurada.
RESEND_API_KEY=""
# Remitente. El default (onboarding@resend.dev) anda sin verificar dominio.
# Con gerstnerwerks.com verificado en Resend: "GerstnerWerks <studio@gerstnerwerks.com>"
MAIL_FROM=""
